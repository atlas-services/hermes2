{% extends '/admin/base.html.twig' %}

{% block title %}{{ 'form.label.show_post'|trans() }}{% endblock %}

{% block content %}
    <h1>{{ 'form.label.show_post'|trans() }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ post.id }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.name'|trans() }}</th>
                <td>{{ post.name }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.position'|trans() }}</th>
                <td>{{ post.position }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.slug'|trans() }}</th>
                <td>{{ post.slug }}</td>
            </tr>
            <tr>
                <th>{{ 'form.label.active'|trans() }}</th>
                <td>{{ post.active ? 'Yes' : 'No' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('post_index') }}">{{ 'form.label.back_to_list'|trans() }}</a>

    <a href="{{ path('post_edit', {'id': post.id}) }}">{{ 'form.label.edit'|trans() }}</a>

    {{ include('admin/post/_delete_form.html.twig') }}
{% endblock %}
