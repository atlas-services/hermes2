{% extends 'base.html.twig' %}

{% block title %}New section{% endblock %}

{% block content %}

    <h1>{{ 'form.label.create'|trans() }}</h1>
    <a class="btn btn-info my-3" href="{{ path('section_index') }}">{{ 'form.label.back_to_list'|trans() }}</a>
{{ form_start(form) }}
    {{ form_row(form.template) }}

    <h3>Posts</h3>
    <div class="posts" data-prototype="{{ form_widget(form.posts.vars.prototype)|e('html_attr') }}">
        {% for post in form.posts %}
            {{ form_row(post.name) }}
            {{ form_row(post.content) }}
        {% endfor %}
    </div>

    <button type="button" class="add-post">Ajouter un post</button>

    <button type="submit">Enregistrer</button>
{{ form_end(form) }}

    <a class="btn btn-info my-3" href="{{ path('section_index') }}">{{ 'form.label.back_to_list'|trans() }}</a>

    <script>
    document.querySelector('.add-post').addEventListener('click', function() {
        const container = document.querySelector('.posts');
        const prototype = container.dataset.prototype;
        const index = container.children.length;
        const newForm = prototype.replace(/__name__/g, index);
        container.insertAdjacentHTML('beforeend', newForm);
    });
</script>
{% endblock %}
