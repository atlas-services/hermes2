{% extends 'base.html.twig' %}

{% block title %}Menu index{% endblock %}

{% block body %}
    <h1>Menus</h1>
    <a class="btn btn-success" href="{{ path('app_menu_new') }}">Create new</a>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Slug</th>
                <th>Up/Down</th>
                <th>Active</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody data-controller="move-item" data-type="menu">
        {% for menu in menus %}
            <tr class="list-item" data-move-item-target="item" data-item-id="{{ menu.id }}"  >
                <td class="col-3">{{ menu.name }}</td>
                <td class="col-3">{{ menu.slug }}</td>
                <td>
                    <button data-action="click->move-item#moveUp">↑</button>
                    <button data-action="click->move-item#moveDown">↓</button>
                </td>
                <td>{{ menu.active ? 'Yes' : 'No' }}</td>
                <td>
                      <a class="py-1 px-2 btn btn-outline-success rounded-3" href="{{ path('app_menu_edit', {'id': menu.id}) }}">{{ ux_icon('fa:edit', {height: '16px', width: '22px', color:"#89c3a5"}) }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <h1>Sub Menus</h1>

    {% for men, submenu in submenus %}
        <h4> {{ men }} </h4>
        <table class="table">
        <thead>
            <tr>
                <th>Sub Menus</th>
                <th>Slug</th>
                <th>Up/Down</th>
                <th>Active</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody data-controller="move-item" data-type="menu">
        {% for child in submenu %}
            <tr class="list-item" data-move-item-target="item" data-item-id="{{ child.id }}" >
                <td class="col-3">{{ child.name }}</td>
                <td class="col-3">{{ child.slug }}</td>
                <td>
                    <button data-action="click->move-item#moveUp">↑</button>
                    <button data-action="click->move-item#moveDown">↓</button>
                </td>
                <td>{{ child.active ? 'Yes' : 'No' }}</td>
                <td>
                    <a class="py-1 px-2 btn btn-outline-success rounded-3" href="{{ path('app_menu_edit', {'id': child.id}) }}">{{ ux_icon('fa:edit', {height: '16px', width: '22px', color:"#89c3a5"}) }}</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <hr/>
    {% else %}
    {% endfor %}


    <a class="btn btn-success" href="{{ path('app_menu_new') }}">Create new</a>
{% endblock %}
