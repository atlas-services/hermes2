<table class="table">
    <thead>
        <tr>
            <th class="col-3">{{ 'form.label.active'|trans() }}</th>
            <th class="col-3">{{ 'form.label.position'|trans() }}</th>
            <th>{{ 'form.label.actions'|trans() }}</th>
        </tr>
    </thead>
    <tbody data-controller="move-item" data-type="menu" data-locale="{{ app.request.locale }}" >
    {% for menu in menus %}
        <tr class="list-item" data-move-item-target="item" data-item-id="{{ menu.id }}"  >
            <td class="col-3">
                <div class="form-check form-switch form-switch-sm my-0">
                    <input data-controller="active-item"  type="checkbox" class="form-check-input bg-success" data-action="click->active-item#switch" {{ menu.active  ? "checked" : "" }}>
                    <label class="custom-control-label">{{ menu.name }}</label>
                </div>
            </td>
            <td  class="col-3">
                <button class="btn btn-outline-success" data-action="click->move-item#moveUp">↑</button>
                <button class="btn btn-outline-success" data-action="click->move-item#moveDown">↓</button>
            </td>
            <td>
                    <a class="py-1 px-2 btn btn-outline-success rounded-3" href="{{ path('menu_edit', {'id': menu.id}) }}">{{ ux_icon('fa:edit', {height: '16px', width: '22px', color:"#89c3a5"}) }}</a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="5">{{ 'form.label.no_record'|trans() }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
