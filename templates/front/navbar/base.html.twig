<nav class="mt-{{ nav_margin_top ?? '0' }}" style="background-color:{{ nav_bgcolor ?? 'transparent' }}; height:{{ nav_height }}; font-family: {{ nav_font_family ?? 'Arial' }} " >
    <div class="mx-auto p-0">
        <div class="mx-0 hidden md:block md:w-auto" id="navbar-multi-level">
            <ul style="background-color:{{ nav_bgcolor ?? 'transparent' }}; " class="offset-sm-{{ nav_offset ?? 0 }} pt-{{ nav_menu_pt ?? 2 }} px-0 flex flex-col md:flex-row ">
                {% for menu in menus %}
                    {% if (app.request.attributes.get('menu') == menu.slug ) %}
                        {% set link_color = nav_color_active %}
                        {% set data_aos = nav_data_aos %}
                    {% else %}
                        {% set link_color = nav_link_color %}
                        {% set data_aos = '' %}
                    {% endif %}
                    {% if menu.children|length == 1  %}
                    <div>
                     <li style="color: {{ link_color ?? '#FFF' }}; {{ nav_menu_text_size ?? 'h6' }}" class="py-{{ nav_link_py ?? 0 }} me-{{ nav_espacement ?? 3 }}">
                       <a style="color:{{ link_color }} ; {{ nav_menu_text_size ?? 'h6' }}" href="{{ path('menu-submenu', {'_locale': app.request.locale, 'menu': menu.slug, 'submenu': menu.slug  }) }}" class="text-decoration-none block {{ nav_menu_text_size ?? 'h6' }}  " aria-current="page">{{ menu.name }}</a>
                    </li>
                        {% if nav_data_aos_active is defined and nav_data_aos_active == 1 %}
                            {% if data_aos == nav_data_aos %}
                                <hr class="d-none d-sm-block me-{{ nav_espacement ?? 3 }}" style="color: {{ link_color ?? '#FFF' }}" data-aos="{{ data_aos ?? ''}}" data-aos-duration="{{ data_aos_duration ?? '' }}" />
                            {% else %}
                                <hr class="d-none d-sm-block me-{{ nav_espacement ?? 3 }}" style="color: {{ link_color ?? '#FFF' }}" />
                            {% endif %}
                        {% endif %}
                    </div>
                    {% else  %}
                    <div>
                        <button style="color: {{ link_color ?? '#FFF' }}" id="mega-menu-dropdown-button" id="dropdownNavbarLinkSub{{menu.id}}" data-dropdown-toggle="dropdownNavbarSub{{menu.id}}" data-bs-toggle="dropdownNavbarSub{{menu.id}}"
                        class=" {{ nav_menu_text_size ?? 'h6' }} py-{{ nav_link_py ?? 0 }} me-{{ nav_espacement ?? 3 }} flex items-center justify-between">
                        {{ menu.name }}
                            <svg class="w-2.5 h-2.5 ms-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                            </svg>
                        </button>
                        {% if nav_data_aos_active is defined and nav_data_aos_active == 1 %}
                            {% if data_aos == nav_data_aos %}
                                <hr class="d-none d-sm-block me-{{ nav_espacement ?? 3 }}" style="color: {{ link_color ?? '#FFF' }}" data-aos="{{ data_aos ?? ''}}" data-aos-duration="{{ data_aos_duration ?? '' }}" />
                            {% else %}
                                <hr class="d-none d-sm-block me-{{ nav_espacement ?? 3 }}" style="color: {{ link_color ?? '#FFF' }}" />
                            {% endif %}
                        {% endif %}
                        </div>


                        <!-- Dropdown menu -->
                        <div id="dropdownNavbarSub{{menu.id}}" class="z-10 hidden ">
                            <ul class="px-0 mt-{{ nav_sub_menu_mt ?? 2 }} " aria-labelledby="dropdownLargeButton">
                                {% for submenu in menu.ownchildren|sort((a, b) => a.position <=> b.position) %}
                                    {% if (app.request.attributes.get('menu') == menu.slug ) and (app.request.attributes.get('submenu') == submenu.slug ) %}
                                        {% set link_color = nav_color_active %}
                                    {% else %}
                                        {% set link_color = nav_link_color %}
                                    {% endif %}
                                    <!-- Dropdown menu -->
                                    <li style="background-color: {{ nav_bgcolor_link ?? 'transparent' }} ;color: {{ link_color ?? '#FFF' }}" class="px-{{ nav_link_px ?? 1 }} py-{{ nav_link_py ?? 1 }}" aria-labelledby="dropdownNavbarLinkSub{{menu.id}}">
                                        <a style="background-color: {{ nav_bgcolor_link ?? 'transparent' }} ;color: {{ link_color ?? '#FFF' }}" class="text-decoration-none block {{ nav_sub_menu_text_size ?? 'h6' }} " href="{{ path('menu-submenu', {'_locale': app.request.locale, 'menu': menu.slug, 'submenu': submenu.slug  }) }}">{{ submenu.name }}</a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </div>
</nav>
