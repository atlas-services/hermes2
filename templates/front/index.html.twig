{% extends 'front/base.html.twig' %}

{% block content %}
    {% for post in posts %}
        <div class="col-sm-{{ post.templateWidth ?? content_container_width ?? '12'}} mx-{{ content_mx ?? 'auto' }} my-0 py-0 ">
            {{ post.content|raw }}
        </div>
    {% endfor %}
{% endblock content %}
